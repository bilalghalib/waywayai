# WayWay AI - Environment Variables Template
# Copy this file to .env.local and fill in your values

# =====================================================
# SUPABASE (Get from: https://app.supabase.com/project/_/settings/api)
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# VERCEL (Auto-populated by Vercel, don't set manually)
# =====================================================
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=

# =====================================================
# AIRTABLE (Legacy - migrate to Supabase)
# =====================================================
# AIRTABLE_API_KEY=your-old-key
# AIRTABLE_BASE_ID=your-old-base

# =====================================================
# OPENAI (for AI features)
# =====================================================
OPENAI_API_KEY=sk-your-key-here

# =====================================================
# REPLICATE (for style transfer / image gen)
# =====================================================
REPLICATE_API_TOKEN=r8-your-token-here

# =====================================================
# STORAGE / CDN
# =====================================================
# Use Supabase Storage by default, or:
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# =====================================================
# ANALYTICS (optional)
# =====================================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =====================================================
# SENTRY (error tracking)
# =====================================================
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=your-auth-token

# =====================================================
# REDIS / UPSTASH (for rate limiting, caching)
# =====================================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# =====================================================
# ENVIRONMENT
# =====================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================
# FEATURES FLAGS
# =====================================================
NEXT_PUBLIC_ENABLE_MULTIPLAYER=true
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
